{
	"schemaVersion": 1,
	"id": "hybrid_delights",
	"version": "${version}",

	"name": "Hybrid Delights",
	"description": "A mod that adds integration between HybridLabs' mods and Farmer's Delight",

	"authors": [
		"Hybrid Labs"
	],

	"contact": {
		"homepage": "https://hybridlabs.net/",
		"sources": "https://github.com/hybridlabs/hybrid-delights",
		"issues": "https://github.com/hybridlabs/hybrid-delights/issues"
	},

	"license": "MIT",
	"icon": "assets/hybrid_delights/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.hybridlabs.delights.HybridDelights",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "dev.hybridlabs.delights.data.HybridDelightsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},

	"depends": {
		"fabricloader": ">=0.19",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-language-kotlin": "*",
		"fabric-api": ">=0.141",
		"hapi": ">=1.3.0",
		"farmersdelight": "*"
	},

	"suggests": {
		"farm_and_charm": "*",
		"hybrid_aquatic": "*"
	}
}
