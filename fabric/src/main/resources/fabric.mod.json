{
	"schemaVersion": 1,
	"id": "hybrid_delights",
	"version": "${version}",

	"name": "Hybrid Delights",
	"description": "A mod that adds integration between HybridLabs' mods and Farmers Delight",

	"authors": [
		"Hybrid Labs"
	],

  "contact": {
    "sources": "https://github.com/hybridlabs/hybrid-delights",
    "issues": "https://github.com/hybridlabs/hybrid-delights/issues"
  },

	"license": "MIT",
	"icon": "assets/hybrid_delights/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.hybridlabs.delights.HybridDelights",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "dev.hybridlabs.delights.data.HybridDelightsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},

  "mixins": [
    "hybrid_delights.mixins.json",
    "hybrid_delights.fabric.mixins.json"
  ],

	"depends": {
      "minecraft": "~1.21.1",
      "java": ">=21",
      "fabric-language-kotlin": "*",
      "fabric-api": ">=0.92",
      "hybrid_aquatic": ">=1.6.3"
    },

	"suggests": {
		"farmersdelight": "*",
		"farm_and_charm": "*"
	}
}
