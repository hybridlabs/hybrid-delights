# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Windows-specific scripts should use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should always use LF.
*.sh text eol=lf

# Common binary files — never modify line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tga binary

*.pdf binary
*.zip binary
*.jar binary
*.war binary
*.7z binary
*.tar binary
*.gz binary

*.mp3 binary
*.ogg binary
*.wav binary
*.mp4 binary
*.mov binary
*.avi binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
